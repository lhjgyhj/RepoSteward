# 环境变量样例：只列变量名与用途，真实值请复制为 .env 后自行填写，切勿提交
# 说明：本文件对应报告 §4.1 确定性内核与 §5.1 安装与账号的配置项

# 异步数据库连接串，格式：postgresql+asyncpg://postgres:<密码>@localhost:5432/reposteward
DATABASE_URL=

# GitHub App Webhook 密钥，用于校验 X-Hub-Signature-256（§4.2 第 1 步、F2.2）
GITHUB_WEBHOOK_SECRET=

# GitHub App 数字 ID，用于生成 App JWT
GITHUB_APP_ID=

# GitHub App 私钥文件在本机的路径（.pem）
GITHUB_PRIVATE_KEY_PATH=

# GitHub OAuth App 的 Client ID，控制台登录用（F1.2）
GITHUB_CLIENT_ID=

# GitHub OAuth App 的 Client Secret，控制台登录用（F1.2）
GITHUB_CLIENT_SECRET=

# 会话签名密钥，随机长字符串
SESSION_SECRET=

# 前端地址，用于 OAuth 回调与跨域白名单，例如 http://localhost:5173
FRONTEND_URL=
